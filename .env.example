# Template for environment variables. Never put real values here.
# Real values live in Vercel (per environment); for local work copy this file to .env.local.

# Sanity project and dataset. Optional: sanity/env.ts defaults to the True Heartland project.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=

# Server only. A Sanity API token with the Viewer role, used for Draft Mode previews.
SANITY_API_READ_TOKEN=

# Server only. Shared secret for the Sanity webhook that calls /api/revalidate.
SANITY_REVALIDATE_SECRET=
